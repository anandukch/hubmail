# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hubmail

# Google OAuth (create a project + OAuth 2.0 Client ID at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" configured on the Google OAuth client
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/oauth/google/callback

# Public base URL of this server, used to build the /mcp/:userToken connector URL shown in the dashboard
PUBLIC_BASE_URL=http://localhost:3000

# Secrets — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes
JWT_SECRET=replace-with-a-long-random-string
